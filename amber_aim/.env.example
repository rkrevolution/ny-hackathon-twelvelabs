# S3-Compatible Storage Configuration
# Works with: AWS S3, Cloudflare R2, Backblaze B2, etc.
# See FREE_DEPLOYMENT.md for free storage options
APP_AWS_S3_BUCKET=your-bucket-name
APP_AWS_REGION=us-east-1
APP_UPLOAD_URL_EXPIRATION=1800
APP_S3_BASE_PATH=upload

# Storage Credentials (for local development)
# For AWS S3: Use IAM roles in production
# For Cloudflare R2: Use R2 Access Key ID and Secret Access Key
# For Backblaze B2: Use Application Key ID and Application Key
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# TwelveLabs API Configuration
# Get your API key at: https://twelvelabs.io/
APP_TWELVE_LABS_API_KEY=your-twelvelabs-api-key
APP_TWELVE_LABS_CREATORS_INDEX_ID=your-creators-index-id
APP_TWELVE_LABS_ADS_INDEX_ID=your-ads-index-id

# OpenAI API Configuration
# Get your API key at: https://platform.openai.com/
# For free alternatives, see AI_OPTIONS.md
OPENAI_API_KEY=your-openai-api-key

# Cache Configuration (for TwelveLabs API optimization)
APP_CACHE_DIR=/tmp/twelvelabs_cache
APP_CACHE_TTL_DAYS=7

# Rate Limiter Configuration (TwelveLabs free tier: 50 calls/day/endpoint)
APP_RATE_LIMIT_STATE_FILE=/tmp/twelvelabs_rate_limit.json

# Application Settings
APP_LOG_LEVEL=INFO
